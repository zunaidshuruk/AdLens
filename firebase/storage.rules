rules_version = '2';

// AdLens — Cloud Storage security rules (Sprint 7B)
//
//   users/{uid}/avatar/{fileName}         profile picture: owner writes, signed-in users read
//   workspaces/{wsId}/logo/{fileName}     workspace logo: owner/admin write, members read
//
// Images only (JPEG, PNG, WebP), max 2 MB. The browser resizes before upload
// (avatar 256 px, logo 512 px) and deletes the previous file after replacing it.
// Workspace membership is read from Firestore (cross-service rules).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') in ['google.com', 'microsoft.com']
      );
    }

    function isImageUpload() {
      return request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function validFileName(fileName) {
      return fileName.matches('^[A-Za-z0-9._-]{1,100}$');
    }

    // Returns the workspace's members map, or an empty map if the workspace doesn't exist,
    // so a missing workspace means "no access" instead of a rules evaluation error.
    function workspaceMembers(wsId) {
      let ws = firestore.get(/databases/(default)/documents/workspaces/$(wsId));
      return ws == null ? {} : ws.data.get('members', {});
    }

    function isMember(wsId) {
      return verified() && request.auth.uid in workspaceMembers(wsId);
    }

    function hasRole(wsId, roles) {
      let members = workspaceMembers(wsId);
      return verified() && request.auth.uid in members && members[request.auth.uid] in roles;
    }

    match /users/{uid}/avatar/{fileName} {
      allow read: if signedIn();
      allow create, update: if verified() && request.auth.uid == uid
                            && validFileName(fileName) && isImageUpload();
      allow delete: if verified() && request.auth.uid == uid;
    }

    match /workspaces/{wsId}/logo/{fileName} {
      allow read: if isMember(wsId);
      allow create, update: if hasRole(wsId, ['owner', 'admin'])
                            && validFileName(fileName) && isImageUpload();
      allow delete: if hasRole(wsId, ['owner', 'admin']);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
