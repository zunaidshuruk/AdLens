# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY_2=""
GEMINI_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth & Encrypted Session Configuration (Sprint 2)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TOKEN_ENCRYPTION_KEY=""
APP_BASE_URL=""

# Meta Marketing API System User Configuration (Sprint 5)
META_ACCESS_TOKEN=""
META_APP_SECRET=""
META_AD_ACCOUNT_ID=""
META_SYSTEM_USER_ALLOWED_EMAILS="zunaid@synesisit.com.bd"

# Firebase Authentication Configuration (Sprint 7A)
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
AUTH_PROVIDERS="password,google"

# PAGESPEED_API_KEY: Optional. Free key for Google PageSpeed Insights (SEO Speed test tab).
PAGESPEED_API_KEY=""
# GOOGLE_CSE_KEY and GOOGLE_CSE_ID: Optional. Google Programmable Search (100 free searches a day). Lets the Content brief find the pages that rank for a keyword by itself.
GOOGLE_CSE_KEY=""
GOOGLE_CSE_ID=""
