{
  "name": "adlens",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "API_PORT=3001 tsx server/index.ts & vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "NODE_ENV=production node dist-server/index.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test",
       "test:rules": "firebase emulators:exec --only firestore,storage --project demo-adlens 'tsx --test --test-concurrency=1 firebase/rules-checks/firestoreRules.check.ts firebase/rules-checks/storageRules.check.ts'",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "firebase-tools": "^15.34.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
